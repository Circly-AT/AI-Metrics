# Same DB_* names as AI-Pipeline-V3, so one .env can serve both.
DB_HOST=CHANGE_ME
DB_PORT=3306
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DATA_DB=circly_data_handling
# TLS to the DB: REQUIRED, no default. `verified` = the server certificate is checked
# against DB_SSL_CA (all three paths required, must be files). `off` = no TLS at all, only
# for an endpoint without TLS (local test DB); certificate paths must then stay empty.
# Leaving TLS unconfigured is not offered: pymysql would encrypt but verify nothing.
DB_TLS=verified
DB_SSL_CA=
DB_SSL_CERT=
DB_SSL_KEY=

# Seconds between polls when the queue is empty.
POLL_INTERVAL_SECONDS=30
# A claimed (job_detected) job whose row has not changed for this long counts as abandoned by its owner.
# It is then ended as error_management. Must be longer than the slowest job (no heartbeat yet).
STALE_GRACE_SECONDS=3600

LOG_LEVEL=INFO
